# =====================================================================
# Checklist de produção (detalhes em docs/deploy.md)
#   APP_ENV=production            liga HTTPS obrigatório, desliga o debug e
#                                 força cookie seguro e sessão criptografada
#   APP_URL=https://...           o sistema só funciona por HTTPS
#   APP_KEY                       php artisan key:generate --show
#   BLIND_INDEX_KEY               openssl rand -hex 32
#   Guarde APP_KEY e BLIND_INDEX_KEY FORA do servidor (cofre de senhas).
#   Sem elas, o backup não pode ser lido. Nunca troque a APP_KEY sem
#   colocar a antiga em APP_PREVIOUS_KEYS.
#   LOG_LEVEL=warning, PATIENT_PHOTOS_PATH num volume com backup
#   php artisan clinic:check confere tudo isso antes de abrir o sistema.
# =====================================================================

APP_NAME=Clinic
APP_ENV=local
APP_KEY=
# Chaves antigas, separadas por vírgula, depois de uma troca da APP_KEY.
# Dados e arquivos criptografados com elas continuam legíveis.
APP_PREVIOUS_KEYS=
# Ignorado em produção: lá o debug fica sempre desligado.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Proxies reversos confiáveis (IPs ou faixas, separados por vírgula). Em
# branco quando o nginx do docker-compose de produção recebe o usuário direto.
# Preencha só se houver balanceador ou Cloudflare na frente. Ver config/trustedproxy.php.
TRUSTED_PROXIES=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Por quantos dias o "Lembrar de mim" mantém o usuário conectado no dispositivo.
AUTH_REMEMBER_DAYS=30

# Chave do índice cego do CPF. Gere com: openssl rand -hex 32
# Trocar esta chave invalida a busca e a unicidade de CPFs já gravados.
BLIND_INDEX_KEY=
CLINIC_TIMEZONE=America/Sao_Paulo
# Dias de antecedência para o alerta de vencimento de lotes.
STOCK_EXPIRY_ALERT_DAYS=60
# Pasta das fotos de procedimento (criptografadas). Padrão: storage/app/private/patient-photos.
# Em produção, aponte para um volume com backup e fora da pasta pública.
# PATIENT_PHOTOS_PATH=

# Backup diário (serviço "backup" do docker-compose.production.yml).
# Pasta no servidor onde ficam as cópias e por quantos dias são mantidas.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14
# Hora local da cópia (0 a 23).
BACKUP_HOUR=2
# Opcional: com uma senha aqui, cada cópia sai criptografada (AES-256).
# Guarde-a junto com APP_KEY e BLIND_INDEX_KEY, fora do servidor.
BACKUP_PASSPHRASE=

LOG_CHANNEL=stack
# Um arquivo por dia em storage/logs, apagado depois de LOG_DAILY_DAYS dias.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Em produção: warning.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# 3307 para não colidir com um MySQL já instalado na máquina (3306).
DB_PORT=3307
DB_DATABASE=clinic
DB_USERNAME=clinic
DB_PASSWORD=
# Usada apenas pelo container do docker-compose, nunca pela aplicação.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Em produção a sessão é sempre criptografada e o cookie sempre seguro (HTTPS),
# qualquer que seja o valor abaixo.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
